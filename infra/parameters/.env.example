AZURE_CLIENT_ID=33333333-3333-3333-3333-333333333333
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=11111111-1111-1111-1111-111111111111
AZURE_PRINCIPAL_OBJECT_ID=22222222-2222-2222-2222-222222222222
AZURE_BUDGET_ALERT_EMAIL=platform@example.com
AZURE_LOCATION=westeurope
GITHUB_REPOSITORY=example-org/merlin-delivery-boilerplate
GITHUB_REPOSITORY_OWNER=example-org
# Resolved by CD, not by an operator. Unlike the overrides below it cannot be commented out:
# blob-service.bicepparam reads it without a default, so local compilation needs a dummy value.
BLOB_CORS_ALLOWED_ORIGIN=https://frontend.example.invalid
# Optional CD custom-origin overrides:
# FRONTEND_BACKEND_URL=https://backend.example.invalid
# BACKEND_FRONTEND_BASE_URL=https://frontend.example.invalid
