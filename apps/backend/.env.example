ENVIRONMENT=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template-db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_SYNC_PREFIX=postgresql://
POSTGRES_ASYNC_PREFIX=postgresql+asyncpg://
CREATE_TABLES_ON_STARTUP=false
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
CORS_ENABLED=false
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1000
ENABLE_DOCS_IN_PRODUCTION=false
OPENAPI_PREFIX=
SECRET_KEY=insecure-secret-key-change-this-in-production
PRODUCTION_SECURITY_VALIDATION_ENABLED=true
PRODUCTION_SECURITY_STRICT_MODE=false
SECURITY_HEADERS_ENABLED=true

SESSION_TIMEOUT_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=15
MAX_SESSIONS_PER_USER=5
SESSION_SECURE_COOKIES=false

CSRF_ENABLED=true

TRUSTED_PROXY_HOPS=0

LOG_LEVEL=INFO
LOG_FORMAT=structured
LOG_CONSOLE_ENABLED=true
LOG_CORRELATION_ID=true
LOG_STRUCTURED_CONTEXT=true
LOG_INCLUDE_STACKTRACE=true
LOG_DEVELOPMENT_VERBOSE=true
LOG_PRODUCTION_OPTIMIZE=true
LOG_PERFORMANCE_METRICS=false
LOG_SQL_QUERIES=false

LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5

SCHEDULED_JOBS_ENABLED=true
SCHEDULED_JOBS_TICK_SECONDS=60

DEBUG=false
APP_NAME=M&A CRM
# Public URL of the web app, used in invitation and reset emails.
APP_URL=http://localhost:3000
# Email logging (ACT-04): users BCC <token>@INBOUND_EMAIL_DOMAIN. The mail provider's inbound-parse
# webhook calls POST /api/v1/email-logging/inbound with header X-Inbound-Secret. Empty = refused.
INBOUND_EMAIL_DOMAIN=log.crm.localhost
INBOUND_EMAIL_SECRET=
APP_DESCRIPTION=Modular FastAPI starter
VERSION=0.1.0
CONTACT_NAME=Support
CONTACT_EMAIL=support@example.com
LICENSE_NAME=MIT

# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json

API_TITLE=
API_DESCRIPTION=
API_SUMMARY=
API_VERSION=
API_TERMS_OF_SERVICE=
API_CONTACT_NAME=
API_CONTACT_EMAIL=
API_CONTACT_URL=
API_LICENSE_NAME=
API_LICENSE_IDENTIFIER=
API_LICENSE_URL=
API_TAGS_METADATA=[]

FIRST_ADMIN_NAME=Admin User
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin123
