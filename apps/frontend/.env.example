# Where FastAPI lives. Server-only on purpose: the browser calls this app's own origin and the
# request is relayed on from there, so the backend URL never reaches the bundle and the backend
# can sit on a private network. Read at runtime, so one build serves every environment.
BACKEND_URL=http://localhost:8000

# How many proxies in front of Next.js may be believed when they name the client's address.
#
# Leave at 0 unless something in front of Next.js *overwrites* X-Forwarded-For (an ingress, a CDN,
# `proxy_set_header X-Forwarded-For $remote_addr`). Next.js fills that header in only when it is
# absent, so with nothing in front, a value the browser invented is indistinguishable from a real
# one, and no address is forwarded at all.
#
# The cost of 0 is that FastAPI sees every request coming from this server, so its login lockout
# keys on one address for the whole app: five failed sign-ins by anyone lock out everyone. Putting
# a proxy in front and setting this to the number of appending hops — plus TRUSTED_PROXY_HOPS=1 on
# the backend — restores per-client lockout with no code change.
BFF_TRUSTED_PROXY_HOPS=0

# How long the relay waits for FastAPI before answering 504. Without a bound, a hung backend pins
# a request handler until the platform's own idle timeout.
BACKEND_TIMEOUT_MS=30000
